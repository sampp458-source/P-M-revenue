# Server-only configuration. Never prefix SOLAPI credentials with VITE_.
# Supabase supplies SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY.
GUARDIAN_MESSAGE_APP_ORIGIN=https://resilient-cat-602568.netlify.app
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=
# Exact business-unit -> actual SOLAPI channel ID mapping; do not invent IDs.
SOLAPI_CHANNEL_MAP={}
# Both server gates AND the new DB config gates default OFF.
GUARDIAN_MESSAGE_SEND_ENABLED=false
GUARDIAN_MESSAGE_INTERNAL_TEST_VERIFIED=false

# off -> internal (explicitly approved numbers only) -> live (only after verified tests).
GUARDIAN_MESSAGE_SEND_SCOPE=off
# No actual phone numbers are preconfigured. Store approved normalized numbers server-side only.
GUARDIAN_MESSAGE_INTERNAL_RECIPIENTS=[]
# Requires separate explicit fallback approval AND DB fallback_enabled=true.
GUARDIAN_MESSAGE_FALLBACK_ENABLED=false
